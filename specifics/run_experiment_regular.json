CLIENT

{
  "version": "1.0",
  "cmd": "run_experiment",
  "session_id": "abc123",

  "experiment_id": "3pulses",
  "shots": 1024,
  "duration_cycles": null,

  "IP_commands": [
    //GenerationIP
    {
      "GENERATOR_IP0" : {
        "drive" : 
        {
        "channel": const. ,
        "frequency": f ,
        "phase": phi,
        "wave_id_list": ["wave_id0", "wave_id1", ...], // mapped to wdw in the board. This is the FIFO list 
      },

      "readout" : {
        "channel": const. ,
        "frequency": f ,
        "phase": phi,
        // no need for wdw -> unica e definita all'inizio (n.b. potrebbe essere limitante! In alcuni esperimenti è interessante usare envelope di readout diverse, anche concatenate!)
      }

      },
      "GENERATION_IP1" : {
        "channel": const. ,
        "frequency": f ,
        "phase": phi,
        "wave_id_list": ["wave_id0", "wave_id1", ...], // mapped to wdw in the board
      },
      "GENERATION_IP2" : { ...},
      ...
    },
    // AcquisitionIP 
    {
      "ACQUISTION_IP0": {
         "channel": const. ,
        "frequency": f ,
        "phase": phi,
        "acquisition_duration": null , // null := calcolato da server o client
      "ACQUISTION_IP1":{ ...},
      "ACQUISTION_IP2":{...}
    }, 
    // TriggerGeneratorIP
    {

      "experiment_duration": #, // calcolato dal server o client
      "shots" : const,
      "channels": {

        # channel1
        {
          "drive" : {
            "delay" : ["t0", "t1", "t2", ...],
            "generate_trigger": ["True/False", "True/False", ...]
          },

          "readout" : {
            // predispone la possibiltà di esperimenti complessi con più readout pulse concatenati
            "delay" : ["t0", "t1", ...]
          }
        },
        # channel 2
        {},
        # channel 3
        {}

      }
    }
  ],

}


SERVER RESPONSE:

{
  "ok": true,
  "cmd": "run_experiment",
  "session_id": "abc123",
  "experiment_id": "exp_001",

  "error_log": null, // forward degli error log defiiti in driver adapters
  "result": {
    "mode": "decimated", 
    "adc_index": 0,
    "data_format": "complex64", // dipende dal mode di acquisizione
    "num_samples": 1000, // nel caso accumulato si può comunque mettere la dimensione della finestra di accumulazione
    "shots": 1024,
    "data": {
      "I": [
        [0.01, 0.02, 0.03, 0.00], // shot 1
        [0.00, -0.01, 0.01, 0.02], // shot 2
        [0.00, -0.01, 0.02, 0.01]  // shot 3
          ...
      ],
      "Q": [
        [0.00, -0.01, -0.02, 0.01], // shot 1
        [0.01, 0.00, -0.01, 0.00], // shot 2
        [0.02, 0.01, 0.00, -0.01]  // shot 3
          ...
      ]
    },
    "timing": {
      "duration_cycles_requested": null,
      "duration_cycles_effective": 10000 // debug della modalità "null" per calcolo automatico esperimento
    },
    "hardware_config": {
      "generators": [
        {
          "index": 0,
          "samplerate_ghz": 4.0,
          "nyquist_zone": 2
        }
      ],
      "acquisitions": [
        {
          "adc_index": 0,
          "mode": "decimated",
          "freq_mhz": 100.0
        }
      ]
    }
  }
}


