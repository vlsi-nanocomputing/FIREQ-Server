    },
    {
      "IP": "GENERATION_IP",
      "t0_cycles": 60,
      "generator": 0,
      "channel": 0,
      "wave_id": "WDW_DRIVE_2", //wave definition word già compilata
      "ttype": "drive",
      "role": "drive_pulse_2"
    },
    {
      "IP": "GENERATION_IP",
      "t0_cycles": 120,
      "generator": 0,
      "channel": 0,
      "wave_id": "WDW_DRIVE_3", //wave definition word già compilata
      "ttype": "drive",
      "role": "drive_pulse_3"
    },
    {
      "IP": "GENERATION_IP",
      "t0_cycles": 400,
      "generator": 0,
      "channel": 0,
      "wave_id": "WDW_READOUT",
      "ttype": "readout",
      "role": "readout_pulse"
    },
    {
      "IP": "ACQUISITION_IP",
      "acq_duration_cycles": 320,
