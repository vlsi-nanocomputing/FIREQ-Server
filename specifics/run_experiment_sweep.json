

REQUEST :

{
  "version": "1.0",
  "cmd": "run_sweep",
  "session_id": "abc123",
  "sweep_id": "gain_freq_2d",

  # interpretazione parametri sweep:
          # singolo numero : costante [oppure lista di un solo elemento]
          # lista [start: float, end: float, N: int, mode : optional] : sweep. start : primo valore da generare (compreso), end: ultimo - - (compreso), N : numero totale di punti , mode: opzionale, se generare secondo qualche logica specifica (N punti equidistanti, assi logaritmici ... potrebbe essere nosense)
          # lista di liste : [[pulse1][pulse2][pulse3]] -> esperimento con più di un drive/readout pulse, ognuno con assi di sweep indipendenti
          # Associazione Pulse <-> trigger : 
          # 
         
  "base": {
    
    // NOTA1 : considerando come sono impostati, si possono anche fare sweep su alcune linee ed esperimenti costanti su altre. Utile per cross-talking fra i qubit ad esempio.
    // NOTA2: in realtà andrebbe pensato un modo per gestire il frequency multiplexing. Più qubit sono normalmente collegati a una singola readout line e letti generando il readout
    // pulse sulla frequenza desiderata. Quindi per lavorare su più qubit in parallelo, servirebbe generare readout pulse su più frequenze in paralello e demodulare opportunamente: 
    // Dato che multiplexing generation e readout non sono ancora gestiti in HW, non la predispongo, e ragione come se nel caso di readout ogni generator IP e acquisition IP gestisse segnali per e da un solo qubit.    
    "sweep_mode" : "cartesian/zipped",
    "sequence": [ 
      // lista di 3 elementi : Istruzioni alle IP 
      // [ { GEN0 = {}, GEN1 = {}, ...}, 
      //   { ACQ = {}, ACQ1 = {}, ... }, 
      //   { TRIG } ] 

      # INSTRUCTIONS TO GENERATOR IPS
      # NOTA BENE: CVNOF VUOL DIRE "CONSTANT, VARIABLE NAME OR FUNCTION"
      {
        "GENERATOR_IP_0" : {
      
        "drive" : { // definizione dei parametri di generazione sulla linea di drive
          "channel" : const. , // sempre constante, definisce il canale di "drive trigger" sul quale il generatore ascolta per generare gli impulsi di drive.
          // questo viene mappato come (pseudocodice): generator_ip_0.set_trigger_channel(type = drive, channel = valore)

          // data converters cannot be interchanged (safely) between each pulse
          "frequency" : CVNOF, 

          // "phase"     : [start, end, N] , ATTENZIONE: la fase iniziale del carrier di drive non esiste
          // "dac_samplerate" : #, // e' fissato dall'OL, non serve passarlo perche' il server lo conosce anche se viene modificato a run-time
          
          // per la generazione degli impulsi vanno definite le envelope (che a questo punto si danno per buone perche' e' stato fatto durante l'handshake iniziale)
          // e le wdw che serviranno per l'esperimento. Quest'ultime possono variare da un iterazione all'altra di un esperimento che include sweep.
          // Infine, per ogni iterazione di uno sweep o in generale per un'esperimento, deve essere definito l'ordine di esecuzione delle wdw.
          "wdw_param" : {
            "wdw_0":{
              "envelope" : ["_RECTANGULAR"],
              "gain"     : CVNOF,
              "duration" : CVNOF, // NOTA: se questa e' una variable, si aspetta che l'inviluppo che e' stato mandato in precedenza sia interpolabile o rettangolare
              "invert_q" : true/false,
              //... tutti gli altri parametri usati in una wdw
            }

            "wdw_1":{
              ....
            }

            ....

            "wdw_n":{
              ....
            }
            // NOTA: stai attento alle VZ gates, che hanno un formato di wdw completamente diverso

            
          } 
        },

        "readout" :{ // definizione dell'impulso e altri parametri di readout

          "channel" : Const, // analogo al drive ma per il readout pulse
          "frequency" : CVNOF,
          "phase"     : CVNOF, // l'impulso di readout invece ha una fase

          "wdw_param" : {
            "envelope_name" : "yotobi",
            "duration" : CVNOF,
            "gain" : CVNOF,
            "switch_iq" :"true/false",
            "keep_last" : "true/false",
          }
        }
      
      },

        "GENERATOR_IP_1" : {
              ...
        }

        ...

      },

      # INSTRUCTIONS TO ACQUISITION IPS
      {
        "ACQUISITION_IP_0" :{
          "frequency" : CVNOF, // si, di solito e' uguale alla frequenza del readout pulse, ma volendo puo' essere diversa (se per esempio uno non vuole fare la demodulazione puo' essere fissato a 0)
          "phase": CVNOF, 
          "channel" : const , // di solito e' uguale al canale di readout usato nel generatore, ma in generale puo' essere diverso
          "acquisiton_duration": CVNOF,
          "time_of_flight": CVNOF, // magari uno vuole testare diversi tof 
          "output_type": "decimated/accumulated/non_decimated ..." // fisso per limiti HW (DMA switch)

        }
        "ACQUISITION_IP_1" : {
          ...
        }
        ... 
      },
      # INSTRUCTIONS TO TRIGGER GENERATOR IP (UNIQUE)
      {
      "experiment_duration": CVNOF, 
      "shots" : const. , // sempre fissi
      "channels": [ 
        {
          "drive": // definizione dei drive trigger channels (drive trigger word)
          {
            // definizione del drive trigger channel 1
            "1":{
              "delay" : [CVNOF , CVNOF, ...], // [#delay0, #delay1, #delay2, ...]
              "generate_trigger": [true/false, true/false, ...],  // questi si riferiscono ai delay, non e' in generale 
            }

            // definizione del drive trigger channel 2
            "2":{
              "delay" : [CVNOF , CVNOF, ...], // [#delay0, #delay1, #delay2, ...]
              "generate_trigger": [true/false, true/false, ...],  // questi si riferiscono ai delay, non e' in generale 
            }
            
            .... // il numero di trigger channels e' variabile ma e' fissato dall'HW, in generale pero' (come il numero di generatori e acquisition_ip) puo' variare

            
          },

          "readout" : 
          {
            // definizione del readout trigger channel 1
            "1":{
              "delay" : CVNOF, // un solo valore per ogni canale
            }

            // definizione del readout trigger channel 2
            "2":{
              "delay" : CVNOF, // un solo valore per ogni canale
            }
          }
        }
        ,
      ], 
    ]
  },

}

